# EpitopeRank Production Environment Variables
# Copy this file to .env.production and fill in your values

# ============================================
# LLM API Configuration (Required)
# ============================================

# DeepSeek API (Recommended for Chinese users)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Alternative: Moonshot AI (Kimi)
# MOONSHOT_API_KEY=sk-your-moonshot-key
# MOONSHOT_MODEL=moonshot-v1-8k

# Alternative: Alibaba DashScope
# DASHSCOPE_API_KEY=sk-your-dashscope-key
# DASHSCOPE_MODEL=qwen-max

# ============================================
# Application Settings
# ============================================

# Server configuration
EPITOPERANK_HOST=0.0.0.0
EPITOPERANK_PORT=8800

# Analysis parameters
EPITOPERANK_FDR_THRESHOLD=0.05
EPITOPERANK_DELTA_PSI_THRESHOLD=0.1
EPITOPERANK_MIN_SUPPORT_READS=10

# Agent settings
EPITOPERANK_AGENT_MODE=agentic
EPITOPERANK_MAX_STEPS=20
EPITOPERANK_REFLECTION_ENABLED=true

# ============================================
# Optional Features
# ============================================

# PubMed literature search
EPITOPERANK_ENABLE_PUBMED=true
PUBMED_API_KEY=your-ncbi-api-key  # Optional, increases rate limit

# External knowledge skills
EPITOPERANK_SKILLS_ENABLED=true
EPITOPERANK_SKILLS_MAX_CALLS=4

# ============================================
# Logging & Monitoring
# ============================================

# Log level (DEBUG, INFO, WARNING, ERROR)
EPITOPERANK_LOG_LEVEL=INFO

# Enable structured JSON logging (recommended for production)
EPITOPERANK_JSON_LOGGING=true

# ============================================
# Security (Optional but Recommended)
# ============================================

# API authentication key (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
EPITOPERANK_API_KEY=your-secret-api-key-here

# CORS allowed origins (comma-separated)
EPITOPERANK_CORS_ORIGINS=https://epitoperank.your-domain.com
