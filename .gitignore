# EpitopeRank (refactored from BioGAIP)

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Test / tooling caches
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# Runtime state (SQLite databases, project outputs) — local disk only
runtime/
/var/tmp/epitoperank/
deploy.tar.gz

# Environments & secrets
.env
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# --- legacy BioGAIP entries (kept for the archived code under legacy/) ---
biolancher/script/windows_gui/out
biolancher/script/windows_gui/python
nf_pipeline_meta/*
conda_pkg_meta/*
bioGen/document/_book/*
biolancher/script/windows_gui/node_modules/*
biolancher/script/windows_gui/python/*
biolancher/script/windows_gui/info/*
/bioag_latest.tar.gz
/bioworker_latest.tar.gz
